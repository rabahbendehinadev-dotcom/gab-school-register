# ── Compiled output ───────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo
.expo-shared

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
*.pem
*.key

# ── User-uploaded files (use Docker volume — never commit) ────────────────────
uploads/
artifacts/api-server/uploads/

# ── Database dumps & backups (NEVER commit client data) ──────────────────────
backups/
*.dump
*.sql
*.bak

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-error.log*

# ── Large or sensitive attached assets ───────────────────────────────────────
attached_assets/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs & editors ────────────────────────────────────────────────────────────
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.cursor/

# ── Replit-specific ───────────────────────────────────────────────────────────
.cache/
.local/
.upm/
.replit
replit.nix

# ── Generated files (rebuilt from source) ─────────────────────────────────────
lib/api-client-react/src/generated/
lib/api-zod/src/generated/

# ── Coverage & test output ────────────────────────────────────────────────────
coverage/
